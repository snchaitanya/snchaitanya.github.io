# Copy this file to .env and fill in the values. See README.md for how to
# get each key. Every var below OWNER_CHAT_ID is optional — the bot runs
# without them, just with that feature quietly disabled.

# --- Required ---
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Leave blank on first run: message the bot, it will reply with your chat
# ID. Put that value here and restart so only you can use the bot.
OWNER_CHAT_ID=

# --- Optional data sources ---
NEWS_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Behavior (sensible defaults if omitted) ---
CLAUDE_MODEL=claude-sonnet-4-5-20250929
TIMEZONE=America/New_York
DAILY_DIGEST_TIME=07:30
DIGEST_TOPICS=AI and data engineering, data privacy regulation, cricket, stock market and interest rates
WATCHLIST=^GSPC,^IXIC,AAPL,MSFT
DEFAULT_JOB_QUERY=data quality engineer
DEFAULT_JOB_LOCATION=remote
DB_PATH=assistant.db
